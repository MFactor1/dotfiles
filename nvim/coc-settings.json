{
	"semanticTokens.enable": false,
	"colors.enable": true,
	"zig.enabled": true,
	"zig.startUpMessage": true,
	"zig.path": "zls",
	"zig.debugLog": false,
	"languageserver": {
		"sql": {
			"module": "/usr/local/lib/node_modules/sql-language-server/dist/bin/cli.js",
			"args": ["up", "--method", "node-ipc"],
			"filetypes": ["sql", "mysql"]
		},
		"rust": {
			"command": "rust-analyzer",
			"filetypes": ["rust"],
			"rootPatterns": ["Cargo.toml"]
		}
	},
    "go.goplsOptions": {
        "completeUnimported": true,
        "matcher": "Fuzzy",
        "symbolMatcher": "FastFuzzy",
        "buildFlags": ["-tags=unit,e2e"]
    },
	"workspace.ignoredFolders": [
		"$HOME",
		"$HOME/.cargo/**",
		"$HOME/.rustup/**"
	]
}
